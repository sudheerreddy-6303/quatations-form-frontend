# ============================================
#  FRONTEND .env  (deeraj-frontend)
# ============================================
CI=false
DISABLE_ESLINT_PLUGIN=true

# Railway backend URL — MUST end with /api
REACT_APP_API_URL=http://localhost:5001/api

# REACT_APP_API_URL=https://quatations-form-backend.onrender.com/api


# Must match API_KEY in the backend exactly
REACT_APP_API_KEY=deeraj-interiors-secret-2025

# For running the frontend against a local backend instead, comment the line
# above and uncomment this:
# REACT_APP_API_URL=http://localhost:5001/api